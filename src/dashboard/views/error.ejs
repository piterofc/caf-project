<%
const codigoErro = error?.status || error?.statusCode || '';
const mensagemErro = error?.message || 'Algo deu errado';
%>
<%- include('partials/head', { title: 'Erro', description: 'Ocorreu um erro ao carregar esta página' }) %>
<body>
    <%- include('./partials/loading') %>
    <%- include('partials/header') %>

    <style>
        @keyframes flutuar {
            0%, 100% { transform: translateY(0) rotate(7deg); }
            50% { transform: translateY(-5px) rotate(3deg); }
        }
        .aureola-anim {
            animation: flutuar 5s ease-in-out infinite alternate;
            transform-origin: center;
            will-change: transform;
        }
        @media (prefers-reduced-motion: reduce) {
            .aureola-anim { animation: none; }
        }
    </style>

    <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
        <div class="card shadow-sm border-0 rounded-4 text-center w-100" style="max-width: 600px;">
            <div class="card-body p-4 p-md-5">
                <img src="/assets/img/aureola.png" class="aureola-anim position-relative" style="width: 110px; height: 110px; margin-bottom: -45px;" alt="Auréola" draggable="false">

                <div class="display-1 text-primary user-select-none" style="font-family: 'Baloo2-ExtraBold', Arial, sans-serif;"><%= codigoErro || 'Ops!' %></div>
                <h1 class="h4 mt-2"><%= mensagemErro %></h1>
                <p class="text-secondary mb-4">Tente novamente em instantes ou fale com o suporte caso o problema continue.</p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="/dashboard" class="btn btn-primary rounded-pill px-4">Voltar</a>
                    <% /*<a href="https://web.fluxer.app/users/1474392489652519770" target="_blank" rel="noopener" class="btn btn-outline-primary rounded-pill px-4">Falar com o suporte</a>*/ %>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer', { showAll: false }) %>
</body>
</html>
