<% if (typeof showCommit === 'undefined') {
    showCommit = false;
} %>
<footer class="bg-caf-dark text-white-50 mt-auto pt-3 pb-3">
    <div class="container">
        <% if (showAll) { %>
        <div class="row g-4 pt-3">
            <div class="col-md-4">
                <h4 class="h5 text-white">Cafofo dos Anjos do Fluxer</h4>
                <p class="mb-0">Integrando a comunidade BR do Fluxer, com servidor e bot exclusivos para a network.</p>
            </div>
            <div class="col-6 col-md-4">
                <h4 class="h5 text-white">Links</h4>
                <ul class="list-unstyled mb-0">
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="https://web.fluxer.app/users/1474392489652519770" target="_blank" rel="noopener">Suporte</a></li>
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="/termos">Termos de Serviço</a></li>
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="/privacidade">Política de Privacidade</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4">
                <h4 class="h5 text-white">Recursos</h4>
                <ul class="list-unstyled mb-0">
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="/participantes">Participantes</a></li>
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="/comandos">Comandos</a></li>
                    <li><a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="/faq">FAQ</a></li>
                </ul>
            </div>
        </div>
        <hr class="border-secondary mt-4">
        <% } %>
        <p class="text-center small mb-0">Feito com ❤️ por <a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="https://web.fluxer.app/users/1474392489652519770" target="_blank" rel="noopener">PiterOfc</a>.</p>
        <p class="text-center small mb-0">&copy; <%= new Date().getFullYear() %> Cafofo dos Anjos do Fluxer. Todos os direitos reservados.</p>
        <% if (showCommit) { %>
            <p class="text-center small mb-0">Commit atual: <a class="link-light link-opacity-75 link-opacity-100-hover text-decoration-none" href="https://github.com/PiterOfc/caf-fluxer-bot/commit/<%= commit.hash %>" target="_blank" rel="noopener"><%= commit.hashShort || 'Desconhecido' %></a></p>
        <% } %>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
