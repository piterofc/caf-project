<%
const STATUS = {
    running:    { label: 'Em andamento', cls: 'text-bg-success' },
    scheduled:  { label: 'Agendado',     cls: 'text-bg-info' },
    pending:    { label: 'Publicando',   cls: 'text-bg-info' },
    publishing: { label: 'Publicando',   cls: 'text-bg-info' },
    ending:     { label: 'Encerrando',   cls: 'text-bg-warning' },
    ended:      { label: 'Encerrado',    cls: 'text-bg-secondary' },
    cancelled:  { label: 'Cancelado',    cls: 'text-bg-danger' },
    failed:     { label: 'Falhou',       cls: 'text-bg-danger' },
};
const formatarData = (ms) => ms ? new Date(ms).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '—';
%>
<%- include('../partials/head', { title: `${guild.name} - Giveaways`, description: `Gerenciar giveaways do servidor ${guild.name} no dashboard da Angel` }) %>
<body>
    <%- include('../partials/loading') %>
    <%- include('../partials/header') %>

    <!-- Cabeçalho do servidor (compacto) -->
    <section class="bg-caf-hero text-white py-2">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3">
                <% if (guild.icon) { %>
                    <img src="https://fluxerusercontent.com/icons/<%= guild.id %>/<%= guild.icon %>.webp" alt="" class="rounded-circle border border-2 border-white shadow-sm" width="44" height="44">
                <% } else { %>
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fs-5 fw-bold border border-2 border-white shadow-sm" style="width: 44px; height: 44px;">
                        <%= guild.name.charAt(0) %>
                    </div>
                <% } %>
                <div class="me-auto text-truncate">
                    <h1 class="h5 mb-0 text-truncate"><%= guild.name %></h1>
                    <small class="text-white-50">Giveaways</small>
                </div>
                <% if (guildConfig?.premium?.enabled) { %>
                    <span class="badge rounded-pill text-bg-warning">⭐ Premium - Nível <%= guildConfig?.premium?.tier %></span>
                <% } %>
                <a href="/dashboard" class="btn btn-sm btn-outline-light rounded-pill">Trocar servidor</a>
            </div>
        </div>
    </section>

    <div class="container-fluid flex-grow-1 py-4 px-4">
        <div class="row g-5">

            <!-- Menu lateral -->
            <aside class="col-lg-3">
                <%- include('../partials/guild-sidebar', { guild, guildConfig, active: 'giveaways' }) %>
            </aside>

            <!-- Conteúdo principal -->
            <main class="col-lg-9">

                <h2 class="h4 mb-3">Novo giveaway</h2>
                <div class="card mb-5" id="card-novo-giveaway">
                    <div class="card-body">
                        <form id="form-novo-giveaway" class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="novo-title">Título</label>
                                <input class="form-control" id="novo-title" maxlength="256" placeholder="Giveaway">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="novo-prize">Prêmio</label>
                                <input class="form-control" id="novo-prize" maxlength="256" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="novo-description">Descrição</label>
                                <textarea class="form-control" id="novo-description" maxlength="4000" rows="2" placeholder="Participe reagindo com 🎉!"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-channel">Canal</label>
                                <select class="form-select" id="novo-channel" required>
                                    <% channels.forEach((channel) => { %>
                                        <option value="<%= channel.id %>">#<%= channel.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-role">Cargo elegível</label>
                                <select class="form-select" id="novo-role">
                                    <option value="">Qualquer cargo</option>
                                    <% roles.forEach((role) => { %>
                                        <option value="<%= role.id %>"><%= role.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-winners">Ganhadores</label>
                                <input type="number" class="form-control" id="novo-winners" min="1" max="100" value="1" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-duration">Duração</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="novo-duration" min="1" value="1">
                                    <select class="form-select" id="novo-duration-unit" style="max-width: 8rem;">
                                        <option value="60">minutos</option>
                                        <option value="3600" selected>horas</option>
                                        <option value="86400">dias</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-start">Início (opcional)</label>
                                <input type="datetime-local" class="form-control" id="novo-start">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="novo-end">Fim (opcional)</label>
                                <input type="datetime-local" class="form-control" id="novo-end">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="novo-host">Organizador (ID do usuário)</label>
                                <input class="form-control" id="novo-host" inputmode="numeric" placeholder="Opcional — por padrão é você">
                            </div>
                            <div class="col-12">
                                <small class="text-muted">Se preencher o <strong>Fim</strong>, a duração é ignorada. Os horários seguem o fuso do seu navegador. Duração entre 10 segundos e 30 dias.</small>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Criar giveaway</button>
                            </div>
                        </form>
                    </div>
                </div>

                <h2 class="h4 mb-3">Histórico</h2>
                <div id="giveaway-history">
                <% if (!giveaways.length) { %>
                    <p class="text-muted">Nenhum giveaway criado.</p>
                <% } %>

                <% giveaways.forEach((item) => { %>
                    <% const status = STATUS[item.status] || { label: item.status, cls: 'text-bg-secondary' }; %>
                    <div class="card mb-3" id="giveaway-<%= item.id %>">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <div class="me-auto">
                                    <h3 class="h6 mb-1"><%= item.title %></h3>
                                    <div class="text-muted small">🎁 <%= item.prize %> · ID <code><%= item.shortId %></code></div>
                                </div>
                                <span class="badge rounded-pill <%= status.cls %>"><%= status.label %></span>
                            </div>

                            <div class="small text-muted mt-2">
                                <div>Canal: <strong>#<%= item.channelName %></strong> · Ganhadores: <strong><%= item.winners %></strong> · Participantes: <strong><%= item.entrantCount %></strong></div>
                                <div>Início: <%= formatarData(item.startAt) %> · Fim: <%= formatarData(item.endAt) %></div>
                                <div>Cargo: <%= item.roleName || 'Qualquer cargo' %> · Organizador: <%= item.hostName || 'Não informado' %></div>
                                <% if (item.winnerNames.length) { %>
                                    <div>Sorteados: <%= item.winnerNames.join(', ') %></div>
                                <% } %>
                                <% if (item.status === 'failed' && item.lastError) { %>
                                    <div class="text-danger">Motivo da falha: <%= item.lastError %></div>
                                <% } %>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <% if (['running', 'scheduled', 'pending'].includes(item.status)) { %>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#editar-<%= item.id %>">Editar</button>
                                <% } %>
                                <% if (item.status === 'running') { %>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-acao="end" data-id="<%= item.id %>" data-confirmar="Encerrar este giveaway agora e sortear os ganhadores?">Encerrar agora</button>
                                <% } %>
                                <% if (['running', 'scheduled', 'pending'].includes(item.status)) { %>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-acao="cancel" data-id="<%= item.id %>" data-confirmar="Cancelar este giveaway? Ninguém será sorteado.">Cancelar</button>
                                <% } %>
                                <% if (item.status === 'ended') { %>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-acao="reroll" data-id="<%= item.id %>" data-confirmar="Sortear mais um ganhador?">Sortear novo ganhador</button>
                                <% } %>
                            </div>

                            <% if (['running', 'scheduled', 'pending'].includes(item.status)) { %>
                                <div class="collapse mt-3" id="editar-<%= item.id %>">
                                    <form class="row g-2 form-editar" data-id="<%= item.id %>">
                                        <div class="col-md-6"><input class="form-control form-control-sm" name="title" value="<%= item.title %>" maxlength="256" placeholder="Título"></div>
                                        <div class="col-md-6"><input class="form-control form-control-sm" name="prize" value="<%= item.prize %>" maxlength="256" placeholder="Prêmio" required></div>
                                        <div class="col-12"><textarea class="form-control form-control-sm" name="description" maxlength="4000" rows="2" placeholder="Descrição"><%= item.description %></textarea></div>
                                        <div class="col-md-3"><input type="number" class="form-control form-control-sm" name="winners" min="1" max="100" value="<%= item.winners %>" placeholder="Ganhadores"></div>
                                        <div class="col-md-4">
                                            <select class="form-select form-select-sm" name="roleId">
                                                <option value="">Qualquer cargo</option>
                                                <% roles.forEach((role) => { %>
                                                    <option value="<%= role.id %>" <%= role.id === item.roleId ? 'selected' : '' %>><%= role.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-md-5"><input class="form-control form-control-sm" name="hostId" value="<%= item.hostId || '' %>" inputmode="numeric" placeholder="Organizador (ID)"></div>
                                        <div class="col-12 d-flex align-items-center gap-3">
                                            <button type="submit" class="btn btn-sm btn-primary">Salvar alterações</button>
                                            <small class="text-muted">O canal, a duração e as datas não podem ser alterados depois de criado.</small>
                                        </div>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>

                <% if (totalPages > 1) { %>
                    <nav aria-label="Paginação de giveaways">
                        <ul class="pagination justify-content-center mb-0 mt-3">
                            <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= page - 1 %>" aria-label="Anterior">Anterior</a>
                            </li>
                            <% for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) { %>
                                <li class="page-item <%= pageNumber === page ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= pageNumber %>"><%= pageNumber %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= page + 1 %>" aria-label="Próxima">Próxima</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
                </div>
            </main>
        </div>
    </div>

    <!-- Avisos -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="toast-feedback" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toast-text"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
            </div>
        </div>
    </div>

    <%- include('../partials/footer', { showAll: false }) %>

    <script>
        const baseUrl = `/api/db/servers/<%= guild.id %>/giveaways`;
        const toastEl = document.getElementById('toast-feedback');
        const toastText = document.getElementById('toast-text');
        // Se o Bootstrap JS não carregar, o aviso ainda aparece (sem depender dele)
        const toast = window.bootstrap ? bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 }) : null;

        function avisar(texto, ok) {
            toastText.textContent = texto;
            toastEl.classList.remove('text-bg-success', 'text-bg-danger');
            toastEl.classList.add(ok ? 'text-bg-success' : 'text-bg-danger');
            if (toast) {
                toast.show();
            } else {
                toastEl.classList.add('show');
                setTimeout(() => toastEl.classList.remove('show'), 3500);
            }
        }

        // Envia para a API; se der certo, avisa e recarrega a lista
        async function enviar({ url, body, okText, errorText, botao }) {
            const textoOriginal = botao?.innerHTML;
            if (botao) {
                botao.disabled = true;
                botao.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Enviando...';
            }

            let sucesso = false;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body ?? {})
                });
                const result = await response.json().catch(() => ({}));

                if (response.ok && result.success !== false) {
                    sucesso = true;
                    avisar(result.message || okText, true);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    avisar(result.error || result.message || errorText, false);
                }
            } catch (err) {
                avisar(errorText, false);
            } finally {
                // Em caso de sucesso a página recarrega, então o botão fica bloqueado para evitar clique duplo
                if (botao && !sucesso) {
                    botao.disabled = false;
                    botao.innerHTML = textoOriginal;
                }
            }
        }

        // datetime-local usa o horário do navegador; convertemos para ISO (UTC) para o servidor não errar o fuso
        function paraIso(valor) {
            if (!valor) return undefined;
            const data = new Date(valor);
            return Number.isNaN(data.getTime()) ? undefined : data.toISOString();
        }

        // Novo giveaway
        document.getElementById('form-novo-giveaway').addEventListener('submit', (e) => {
            e.preventDefault();
            const valor = (id) => document.getElementById(id).value.trim();
            const fim = paraIso(valor('novo-end'));

            const body = {
                title: valor('novo-title'),
                prize: valor('novo-prize'),
                description: valor('novo-description'),
                channelId: valor('novo-channel'),
                roleId: valor('novo-role'),
                hostId: valor('novo-host'),
                winners: Number(valor('novo-winners')),
                startAt: paraIso(valor('novo-start')),
            };
            if (fim) {
                body.endAt = fim;
            } else {
                body.duration = Math.round(Number(valor('novo-duration')) * Number(valor('novo-duration-unit')));
            }

            enviar({
                url: baseUrl,
                body,
                okText: 'Giveaway criado com sucesso!',
                errorText: 'Erro ao criar giveaway.',
                botao: e.target.querySelector('button[type="submit"]')
            });
        });

        function vincularAcoesDoHistorico() {
            document.querySelectorAll('#giveaway-history .form-editar').forEach((form) => {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const dados = new FormData(form);
                    const body = {};
                    for (const [chave, valor] of dados.entries()) body[chave] = String(valor).trim();

                    enviar({
                        url: `${baseUrl}/${form.dataset.id}/edit`,
                        body,
                        okText: 'Giveaway atualizado com sucesso!',
                        errorText: 'Erro ao editar giveaway.',
                        botao: form.querySelector('button[type="submit"]')
                    });
                });
            });

            document.querySelectorAll('#giveaway-history [data-acao]').forEach((botao) => {
                botao.addEventListener('click', () => {
                    if (botao.dataset.confirmar && !confirm(botao.dataset.confirmar)) return;
                    enviar({
                        url: `${baseUrl}/${botao.dataset.id}/${botao.dataset.acao}`,
                        body: {},
                        okText: 'Ação concluída com sucesso!',
                        errorText: 'Erro ao executar a ação.',
                        botao
                    });
                });
            });
        }

        async function trocarPagina(url, atualizarHistorico = true) {
            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error('Não foi possível carregar esta página de giveaways.');
            const html = await response.text();
            const documento = new DOMParser().parseFromString(html, 'text/html');
            const novoHistorico = documento.getElementById('giveaway-history');
            const historicoAtual = document.getElementById('giveaway-history');
            if (!novoHistorico || !historicoAtual) throw new Error('Resposta de paginação inválida.');
            historicoAtual.replaceWith(novoHistorico);
            if (atualizarHistorico) window.history.pushState({}, '', url);
            vincularAcoesDoHistorico();
            vincularPaginacao();
        }

        function vincularPaginacao() {
            document.querySelectorAll('#giveaway-history .page-link').forEach((link) => {
                link.addEventListener('click', async (event) => {
                    event.preventDefault();
                    if (link.closest('.page-item')?.classList.contains('disabled') || link.closest('.page-item')?.classList.contains('active')) return;
                    const historico = document.getElementById('giveaway-history');
                    historico.classList.add('opacity-50');
                    try {
                        await trocarPagina(link.href);
                    } catch (error) {
                        avisar(error.message, false);
                    } finally {
                        document.getElementById('giveaway-history')?.classList.remove('opacity-50');
                    }
                });
            });
        }

        window.addEventListener('popstate', () => trocarPagina(window.location.href, false).catch((error) => avisar(error.message, false)));
        vincularAcoesDoHistorico();
        vincularPaginacao();
    </script>
</body>
</html>
