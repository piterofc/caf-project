<%- include('./partials/head', {
    title: 'Login',
    description: 'Entre com a sua conta do Fluxer para acessar o painel do bot do CAF.'
}) %>
<body>
    <%- include('./partials/loading') %>

    <style>
        /* Só o que é específico do login: tema, fonte, fundo, scrollbar e seleção vêm do partial head */
        .hero-section {
            background: linear-gradient(135deg, #6c63ff, #3f3d56);
            color: white;
            padding: 70px 0 110px;
            text-align: center;
        }
        .hero-section h1 {
            font-size: 3.2rem;
            margin-bottom: 10px;
        }
        .hero-section p {
            font-size: 1.3rem;
            margin: 0;
        }
        .login-section {
            flex: 1;
            padding: 0 0 60px;
        }
        .login-card {
            background-color: var(--bs-body-bg);
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            padding: 30px;
            text-align: center;
            margin-top: -70px;
            font-family: 'Baloo2-ExtraBold', Arial, sans-serif;
        }
        .login-card .avatar {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #6c63ff;
            margin-bottom: 15px;
        }
        .login-card h2 {
            font-size: 1.8rem;
            margin-bottom: 10px;
        }
        .login-card p {
            color: var(--bs-secondary-color);
            margin-bottom: 25px;
        }
        .login-card .btn {
            color: white;
            font-weight: bold;
            padding: 10px 30px;
            border-radius: 50px;
            background-color: #6c63ff;
            transition: background-color 0.3s ease-in-out;
        }
        .login-card .btn:hover {
            background-color: #5a54d1;
            color: white;
        }
        .login-card .btn:focus-visible {
            outline: 3px solid #FFD25A;
            outline-offset: 2px;
        }
        .login-card .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #6c63ff;
            text-decoration: none;
        }
        .login-card .back-link:hover {
            color: #5a54d1;
            text-decoration: underline;
        }

        /* Botões flutuantes (a página não tem menu) */
        .btn-glass {
            background: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #fff;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            transition: background-color .3s ease-in-out, transform .3s ease-in-out;
        }
        .btn-glass:hover, .btn-glass:focus-visible {
            background: rgba(255, 255, 255, 0.32);
            color: #fff;
        }
        #botao-tema:hover { transform: rotate(20deg); }

        .alert {
            border-radius: 10px;
            font-family: Arial, sans-serif;
            text-align: left;
        }
        .site-footer {
            background-color: #3f3d56;
            color: rgba(255,255,255,0.75);
            text-align: center;
            padding: 20px 0;
            font-size: 0.9rem;
        }
    </style>

    <!-- Voltar (canto esquerdo) -->
    <a href="/" id="botao-voltar" class="btn btn-glass rounded-pill px-3 position-fixed top-0 start-0 m-3 shadow-sm" style="z-index: 1030;" aria-label="Voltar para a página anterior">
        <span aria-hidden="true">&larr;</span> Voltar
    </a>

    <!-- Tema (canto direito) -->
    <button type="button" id="botao-tema" class="btn btn-glass rounded-circle position-fixed top-0 end-0 m-3 shadow-sm d-flex align-items-center justify-content-center fs-5" style="z-index: 1030; width: 44px; height: 44px;" aria-label="Alternar tema">
        <span id="tema-icone" aria-hidden="true">🌙</span>
    </button>

    <section class="hero-section">
        <div class="container">
            <h1>Painel do Bot</h1>
            <p>Gerencie o bot do Cafofo dos Anjos do Fluxer.</p>
        </div>
    </section>

    <section class="login-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-5">
                    <div class="login-card">
                        <% /* %>
                        <% if (error && error.length > 0) { %>
                            <div class="alert alert-fechar alert-danger alert-dismissible fade show" role="alert">
                                <%= error[0] %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                            </div>
                        <% } %>

                        <% if (success && success.length > 0) { %>
                            <div class="alert alert-fechar alert-success alert-dismissible fade show" role="alert">
                                <%= success[0] %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                            </div>
                        <% } %>
                        <% */ %>

                        <% if (avatar) { %>
                            <img src="<%= avatar %>" class="avatar" alt="Avatar de <%= user %>">
                        <% } %>
                        <h2>Bem-vindo, <%= user %>!</h2>
                        <p>Entre com a sua conta do Fluxer para acessar o painel.</p>

                        <a href="/auth/fluxer" class="btn btn-lg">Entrar com o Fluxer</a>
                        <div>
                            <a href="/" class="back-link">Voltar para o início</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer', { showAll: true }) %>

    <!-- Avisos -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="toast-feedback" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toast-text"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Fecha automaticamente os alertas de sucesso/erro após 3,5 segundos
        document.querySelectorAll('.alert-fechar').forEach(alerta => {
            setTimeout(() => {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alerta);
                bsAlert.close();
            }, 3500);
        });

        const toastEl = document.getElementById('toast-feedback');
        const toastText = document.getElementById('toast-text');
        // Se o Bootstrap JS não carregar, o aviso ainda aparece (sem depender dele)
        const toast = window.bootstrap ? bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 }) : null;

        function avisar(texto, ok) {
            toastText.textContent = texto;
            toastEl.classList.remove('text-bg-success', 'text-bg-danger');
            toastEl.classList.add(ok ? 'text-bg-success' : 'text-bg-danger');
            if (toast) {
                toast.show();
            } else {
                toastEl.classList.add('show');
                setTimeout(() => toastEl.classList.remove('show'), 3500);
            }
        }

        // Se houver mensagens flash do servidor, exibe-as
        <% if (success && success.length > 0) { %>
            avisar(<%- JSON.stringify(success[0]).replace(/</g, '\\u003c') %>, true);
        <% } %>
        <% if (error && error.length > 0) { %>
            avisar(<%- JSON.stringify(error[0]).replace(/</g, '\\u003c') %>, false);
        <% } %>

        // Voltar: usa o histórico do navegador; sem histórico, vai para o início
        document.getElementById('botao-voltar').addEventListener('click', function (e) {
            if (window.history.length > 1) {
                e.preventDefault();
                window.history.back();
            }
        });

        // Alternar tema claro/escuro
        (function () {
            const botao = document.getElementById('botao-tema');
            const icone = document.getElementById('tema-icone');
            const html = document.documentElement;

            function atualizarBotao() {
                const escuro = html.getAttribute('data-bs-theme') === 'dark';
                icone.textContent = escuro ? '☀️' : '🌙';
                botao.setAttribute('aria-label', escuro ? 'Mudar para o tema claro' : 'Mudar para o tema escuro');
                botao.setAttribute('title', escuro ? 'Tema claro' : 'Tema escuro');
            }

            botao.addEventListener('click', function () {
                const novo = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-bs-theme', novo);
                try { localStorage.setItem('caf-tema', novo); } catch (e) {}
                atualizarBotao();
            });

            atualizarBotao();
        })();
    </script>
</body>
</html>
